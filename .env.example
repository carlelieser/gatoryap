# Copy to .env and adjust. The server also runs with no .env at all — these are
# the built-in defaults, which match docker-compose.yml.

# HTTP
PORT=8080
HOST=0.0.0.0

# Database. Any managed Postgres reachable over JDBC works; the server is not
# tied to a specific provider. In production supply the provider's URL here.
DATABASE_URL=jdbc:postgresql://localhost:5433/gatoryap
DATABASE_USER=gatoryap
DATABASE_PASSWORD=gatoryap
DATABASE_MAX_POOL_SIZE=10

# Set to "production" in deployed environments. Decides whether missing
# security-critical settings stop the server from starting.
APP_ENV=development

# Authentication.
#
# JWT_SECRET has no built-in default, unlike everything else here. Left unset,
# the server generates a temporary one at boot and says so — tokens then stop
# working when it restarts, which is fine in development. With
# APP_ENV=production it refuses to start instead, so a development key cannot
# reach production unnoticed. Generate one with:
#   openssl rand -base64 32
JWT_SECRET=
JWT_ISSUER=gatoryap
JWT_AUDIENCE=gatoryap-app

# Access tokens are self-contained, so logout cannot retract one already
# issued; it stays valid for this long. Keep it short.
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# Attempts allowed per address on /auth/login and /auth/register. Counted in
# memory, so the count is per instance and resets on deploy.
AUTH_RATE_LIMIT_ATTEMPTS=10
AUTH_RATE_LIMIT_WINDOW_MINUTES=1
